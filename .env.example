# Copy to .env and fill in. Never commit .env.
# Primary: hosted open-weight model (OpenAI-compatible endpoint).
# ZERO SPEND (decision D9): use only free tiers / free model variants, and never add a payment method.
# Fanar API (request a key at https://api.fanar.qa/request); extraction model: Fanar-C-2-27B
LLM_BASE_URL=https://api.fanar.qa/v1
LLM_API_KEY=
LLM_MODEL_REASONING=
LLM_MODEL_EXTRACT=
# Secondary: Colab vLLM endpoint (via Cloudflare tunnel), optional
COLAB_LLM_BASE_URL=
COLAB_LLM_API_KEY=
# replay = use recorded responses (CI / offline demo); live = call endpoints
LLM_MODE=replay
DATABASE_URL=postgresql://venture:venture@localhost:5432/venture_os
SEARXNG_URL=http://localhost:8080
LLM_MODEL_CODE=
# Judge must be a different model family from LLM_MODEL_REASONING
LLM_MODEL_JUDGE=
COLAB_LLM_MODEL=
# Admin API token for /admin routes (long random string). Leave empty to disable admin routes.
ADMIN_TOKEN=
