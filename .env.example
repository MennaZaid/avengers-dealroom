# Optional. `docker compose up` works with NO .env: an open-weight model runs locally in Ollama ($0 per run).
# Copy to .env only to change a setting. Never commit .env. Placeholders only in this file.
# ZERO SPEND: local models or free tiers only; never add a payment method to any account.

# --- Host ports (change if one is taken on your machine) -------------------------------------------
UI_PORT=8501
API_PORT=8010
DB_PORT=5432
SEARXNG_PORT=8080
OLLAMA_PORT=11434

# --- Model (any OpenAI-compatible endpoint) --------------------------------------------------------
# live = call the model below; replay = no model calls (rule-based fallbacks, used by CI)
LLM_MODE=live
# Default: the local Ollama service from docker-compose.yml (from the host use http://localhost:11434/v1)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
# Open-weight model pulled and warmed by the `ollama-pull` service (Qwen3-4B-Instruct-2507, Apache-2.0).
OLLAMA_MODEL=qwen3:4b-instruct
LLM_MODEL_EXTRACT=qwen3:4b-instruct
LLM_MODEL_REASONING=qwen3:4b-instruct
# "none" turns off qwen3 "thinking" (much faster on CPU). Set it empty for hosted APIs that reject the field.
LLM_REASONING_EFFORT=none
LLM_MODEL_CODE=
# Judge should be a different model family from LLM_MODEL_REASONING
LLM_MODEL_JUDGE=
# USD per 1M tokens, for the cost-per-run report. 0 for local models and free tiers.
LLM_PRICE_PER_1M_TOKENS=0
# Seconds before an onboarding/agent model call gives up and the rule-based fallback answers instead
LLM_CHAT_TIMEOUT=120

# Optional free hosted route instead of Ollama (example: Fanar, Arabic incl. Egyptian dialect; key from
# https://api.fanar.qa/request). Uncomment and replace the LLM_ lines above:
# LLM_BASE_URL=https://api.fanar.qa/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL_EXTRACT=Fanar-C-2-27B
# LLM_REASONING_EFFORT=

# Optional secondary endpoint: Colab/Kaggle GPU behind a Cloudflare tunnel
COLAB_LLM_BASE_URL=
COLAB_LLM_API_KEY=
COLAB_LLM_MODEL=

# --- Paths and services (set automatically inside docker compose; these values are for running on the host) --
DATABASE_URL=postgresql://venture:venture@localhost:5432/venture_os
SEARXNG_URL=http://localhost:8080
API_URL=http://localhost:8010
PROMPTS_DIR=prompts
DECISION_LOG_PATH=decision_log.json
OUTPUTS_DIR=outputs
DATA_DIR=data

# Admin API token for /admin routes (long random string). Leave empty to disable admin routes.
ADMIN_TOKEN=
# --- Discover research (phase 1) --------------------------------------------------------------------
# Embeddings for the hybrid evidence/corpus search (local Ollama, free). Inside compose: http://ollama:11434
EMBED_URL=http://localhost:11434
EMBED_MODEL=bge-m3
# Seconds between web searches: SearXNG's free upstream engines suspend us after ~10 fast queries.
SEARXNG_MIN_INTERVAL=2.5
# Optional free GitHub token (no scopes) for a higher API rate limit. Leave empty to run without one.
GITHUB_TOKEN=
# Optional dedicated endpoint per agent profile (e.g. a judge from a different model family, free tier only):
# LLM_JUDGE_BASE_URL=
# LLM_JUDGE_API_KEY=
# LLM_JUDGE_MODEL=
# Optional per-role providers (free tiers only). Each role tries its own endpoint, then LLM_BASE_URL, then local
# Ollama (qwen3:4b-instruct), then the rule-based path. Example: Validate on Groq's open-weight gpt-oss-120b.
# LLM_VALIDATE_BASE_URL=https://api.groq.com/openai/v1
# LLM_VALIDATE_API_KEY=your-key-here
# LLM_VALIDATE_MODEL=openai/gpt-oss-120b
# LLM_REASONING_BASE_URL=
# LLM_REASONING_API_KEY=your-key-here
# LLM_REASONING_MODEL=
# Seconds before a model call is abandoned (a 4B model on a laptop CPU writes ~4 tokens/s)
LLM_TIMEOUT=900
# Discover: at most this many page sections are read by the model per run; the rest use the rule extractor
MODEL_EXTRACT_CALLS=12
