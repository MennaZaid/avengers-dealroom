# Copy to .env and fill in. Never commit .env. Free tiers only.
# Main model (Groq free tier)
LLM_REASONING_BASE_URL=https://api.groq.com/openai/v1
LLM_REASONING_MODEL=openai/gpt-oss-120b
LLM_REASONING_API_KEY=your-groq-key
# Fallback model (Fanar, free key from https://api.fanar.qa/request)
LLM_BASE_URL=https://api.fanar.qa/v1
LLM_API_KEY=your-fanar-key
LLM_MODEL_REASONING=Fanar-C-2-27B
# Local search engine from docker-compose.yml (only needed to re-run research)
SEARXNG_URL=http://localhost:8080
