{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "venture_os.api.main:app", "--port", "8010"],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "ui",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "ui/app.py", "--server.port", "8501", "--server.headless", "true", "--", "--api", "http://localhost:8010"],
      "port": 8501
    }
  ]
}
